// The configuration of the Datumesh local resolver (datumesh-local 0.1.0), installed at first
// run. JSON; a line whose first non-blank characters are // is a comment.
{
  // The hosts the resolver may fetch from. Nothing else ever reaches the network: a fetch is
  // explicit (get of a cell not held, prefetch, refresh, a forwarded request) and goes
  // through the Datumesh HTTP client to these hosts only. The default is datumesh.com plus
  // mesh-test.datumesh.com, the test mesh, so the tests and the first run work; remove the
  // test mesh when you no longer use it.
  "allowlist": ["datumesh.com", "mesh-test.datumesh.com"],

  // The licence gate (since 0.2.0) is the engine's licence inheritance (spec-0.4.3 8.5) and
  // needs no configuration: an input under an open licence (CC0-1.0, PDDL-1.0, MIT,
  // Apache-2.0, CC-BY-4.0, OGL-UK-3.0, CC-BY-SA-4.0, ODbL-1.0) or a local one is computed
  // over here, the result carrying the inherited licence; an input under any other licence
  // (every https:// one included) is restricted: when the function's publisher declares it
  // (its key document's declarations) the request is forwarded to forward_mesh, since a
  // restricted licence is never signed by this machine's key; otherwise it is answered
  // unlicensed here. Restricted cells the mesh delivers are held like any other: the licence
  // binds computation, not delivery. The open_licences list of 0.1.0 and 0.1.1 is no longer
  // used; a file that has it still loads (deprecated, ignored).

  // The mesh that answers what the gate forwards (declared restricted inputs), and the mesh a
  // remote calc and the licence register are read from (datumesh-local 0.5.1: production).
  "forward_mesh": "datumesh.com",

  // The meshes `find` asks when the local names give no answer, and always with --remote (one
  // request each, its answer kept 24 hours); with --remote the forward_mesh is asked too. A host
  // must also be in the allowlist to be asked.
  "find_meshes": ["datumesh.com"],

  // true: no fetch at all; a cell not held answers error E_FOREIGN_UNAVAILABLE.
  "offline": false,

  // The licence of the receipts this machine signs for cells without inputs (8.5's "no
  // inputs": the mesh's own licence); every other receipt carries the inherited licence.
  "licence": "CC-BY-4.0",

  // Origins to use instead of https://<host> for some hosts (tests, private networks).
  "peers": {},

  // The time limit of one request to a mesh, in seconds.
  "timeout_seconds": 10,

  // The most members one evaluation fetches from the mesh for the slices it reads and does not
  // hold (a lookup narrowed by its bound fetches its range), summed over the slices it reads. Past
  // it the evaluation is refused with E_SLICE_FETCH_LIMIT and nothing it fetched is kept; prefetch
  // the slice first to hold it. 50,000 covers the whole of Bank Rate's history (13,118 members) and
  // one currency of the ECB references (about 7,000).
  "slice_fetch_max": 50000,

  // The store: null for <data directory>/store.sqlite, a SQLite path, or a postgres:// URL.
  "store": null,

  // The machine key (Ed25519 seed, mode 0600): null for <config directory>/machine.key.
  "key_file": null,

  // The alias map: null for <config directory>/aliases.json.
  "aliases_file": null
}
